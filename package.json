{
  "name": "babel-breaker-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based translation tool for mods, modpacks, worlds, Add-ons, resource packs, data packs, and server plugins.",
  "scripts": {
    "prepare:legal": "node scripts/prepare-legal.mjs",
    "prepare:registry": "node scripts/prepare-registry.mjs",
    "sync:models": "node scripts/sync-model-catalog.mjs",
    "dev": "npm run prepare:legal && npm run prepare:registry && vite --host 127.0.0.1",
    "build": "npm run prepare:legal && npm run prepare:registry && vite build",
    "build:firebase": "node scripts/build-firebase.mjs",
    "check:firebase": "npm run test && npm run build:firebase && npm run verify:model-hosting",
    "verify:model-hosting": "node scripts/verify-model-hosting.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests-web/*.test.js",
    "check": "npm run test && npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IGNORANZ-PROJECT/BabelBreaker.git"
  },
  "bugs": {
    "url": "https://github.com/IGNORANZ-PROJECT/BabelBreaker/issues"
  },
  "homepage": "https://babel-breaker.web.app/",
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "jszip": "3.10.1",
    "mcbe-leveldb-reader": "2.0.1",
    "pako": "1.0.11",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "spdx-license-list": "^6.12.0",
    "vite": "7.3.6"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=20"
  }
}
